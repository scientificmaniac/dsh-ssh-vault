{
  "name": "dsh-ssh-vault-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo companion for dsh-ssh-vault: renders the same UI with fabricated hosts so storefront screenshots carry no real addresses or accounts",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
