{
  "name": "dsh-ssh-vault",
  "version": "1.6.3",
  "type": "module",
  "description": "Encrypted SSH host vault and model-facing SSH tools for the DeepSeek Harness",
  "license": "MIT",
  "author": "scientificmaniac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scientificmaniac/dsh-ssh-vault.git"
  },
  "bugs": {
    "url": "https://github.com/scientificmaniac/dsh-ssh-vault/issues"
  },
  "homepage": "https://github.com/scientificmaniac/dsh-ssh-vault#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "ssh",
    "vault",
    "encryption"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/diagnose.mjs && node test/unit.mjs && node test/background.mjs && node test/vault-api.mjs",
    "test:live": "node test/live.mjs",
    "test:self": "node test/selftest.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "SECURITY.md",
    "SECURITY.en.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "SSH Vault",
    "description": "Connect to Linux hosts over SSH with the host address, port, account, and password kept in an encrypted vault."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
